# The env the app is running in e.g. development, testflight, production
EXPO_PUBLIC_ENV=development

# Product name used in the native app name, page titles, user agent, and
# attribution headers. Defaults to Purrsky when unset.
EXPO_PUBLIC_APP_NAME=

# This is the semver release version of the app, pulled from package.json
EXPO_PUBLIC_RELEASE_VERSION=

# This is the commit hash that the current bundle was made from.
EXPO_PUBLIC_BUNDLE_IDENTIFIER=

# Set to 1 by the release workflow's legacy iOS leg, never in a normal build.
# It drops react-native-executorch from iOS autolinking so the IPA runs on
# iOS 16, and hides the on-device alt text UI that would need it. See
# react-native.config.js and docs/build.md.
# EXPO_PUBLIC_LEGACY_IOS=1

# Should be formatted YYMMDDHH so that it increases for each build.
EXPO_PUBLIC_BUNDLE_DATE=0

# OAuth client origins. Web and native use separate clients because atproto
# requires a native client's private-use redirect scheme to be its client_id
# hostname in reverse-domain order, so one host maps to one scheme.
EXPO_PUBLIC_OAUTH_BASE_URL=https://witchsky.app
# Defaults to https://app.puppykitty.racing, whose metadata serves the
# racing.puppykitty.app:/auth/callback redirect.
EXPO_PUBLIC_OAUTH_NATIVE_BASE_URL=

# The log level for the app's logger transports
EXPO_PUBLIC_LOG_LEVEL=debug

# Enable debug logs for specific logger instances
EXPO_PUBLIC_LOG_DEBUG=session

# Bluesky appview DID
EXPO_PUBLIC_BLUESKY_PROXY_DID=

# Chat service DID
EXPO_PUBLIC_CHAT_PROXY_DID=

# Moderation service DID (override when running Ozone locally)
EXPO_PUBLIC_MOD_PROXY_DID=

# Optional local appview override when the dev environment uses non-default ports
EXPO_PUBLIC_DEV_ENV_APPVIEW_URL=

#
#
# Bluesky specific values
#
#

# Optional direct metrics ingestion endpoint.
# If unset, metrics fall back to Sentry/GlitchTip when EXPO_PUBLIC_SENTRY_DSN is set.
EXPO_PUBLIC_METRICS_API_HOST=

# Growthbook config
EXPO_PUBLIC_GROWTHBOOK_API_HOST=
EXPO_PUBLIC_GROWTHBOOK_CLIENT_KEY=

# Sentry-compatible DSN for telemetry, including GlitchTip.
EXPO_PUBLIC_SENTRY_DSN=

# Bitdrift API key. If undefined, Bitdrift will be disabled.
EXPO_PUBLIC_BITDRIFT_API_KEY=

# geolocation web worker URL
GEOLOCATION_DEV_URL=

# live-events web worker URL
LIVE_EVENTS_DEV_URL=

# app-config web worker URL
APP_CONFIG_DEV_URL=
